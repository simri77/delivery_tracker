datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  phone     String?
  tier      String    @default("Standard Member")
  points    Int       @default(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  orders    Order[]
  addresses Address[]
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  addressLine  String
  city         String
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Relation to User
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  orderIdString   String      @unique
  status          String      @default("processing") // e.g., 'out_for_delivery', 'delivered'
  estimatedTime   String?
  driverName      String?
  deliveryAddress String?
  totalPrice      Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  name      String
  quantity  Int
  price     Float

  // Relation to Order
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}